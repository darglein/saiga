#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SAIGA_VERSION_MAJOR@,@SAIGA_VERSION_MINOR@,@SAIGA_VERSION_PATCH@,0
 PRODUCTVERSION @SAIGA_VERSION_MAJOR@,@SAIGA_VERSION_MINOR@,@SAIGA_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "@VERSION_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@VERSION_STRING@"
            VALUE "InternalName", "@TARGET_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2021 Darius Rückert"
            VALUE "OriginalFilename", "@TARGET_NAME@.dll"
            VALUE "ProductName", "Saiga"
            VALUE "ProductVersion", "@VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
