#extension GL_GOOGLE_include_directive : require

// The preview conversion of S36's LightingDebug (A8): a source image's values -> an RGBA8 preview (the value mapping:
// range, log2, colour map) and their reduction (min, max, mean, a 16-bin histogram over the mapped range), in three
// dispatches (pc.pass): 0 per workgroup min / max / sum / count of the finite values into partials, 1 one workgroup
// reduces the partials into the statistics and the range (auto: min / max, else the push constant's), 2 the conversion
// and the histogram. Value of a texel: luminance (kind 0: luma(rgb) * scale) or the first channel (kind 1) of the 2D
// source's texel at p * step (a preview at a lower resolution than its source: every step-th texel); S36a2 a layer of
// the array source (kind 2: the minimum of the first channel over the step x step texels a preview texel covers, a
// depth map's casters stay visible; kind 3: the first, kind 4: the second channel at the block's first texel), with
// layers > 1 every layer side by side (the strip; its workgroups are aligned to the layers, a workgroup never spans two
// layers, so that each workgroup's partial belongs to one layer's range). The histogram is counted over the reported
// range (not a strip layer's own) in shared memory, one global add per bin and workgroup (the Statistics buffer is
// device local; LightingDebug copies it to the host).

#include "../color.glsl"
#include "debug_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 4) uniform sampler2DArray sourceArray;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D preview;
layout(std430, set = 0, binding = 2) buffer Partials
{
    vec4 partials[];  // min, max, sum, count per workgroup
};
layout(std430, set = 0, binding = 3) buffer Statistics
{
    vec4 stats;  // min, max, mean, count
    vec4 range;  // min, max of the mapping
    uint histogram[16];
    // S36a2: per layer of a strip the auto range (min, max; the strip maps each layer by its own range, a cascade's
    // depth spans a small part of the shared range)
    vec4 layerRange[4];
};

layout(push_constant) uniform Push
{
    ivec2 size;
    uint pass;
    uint kind;
    float scale;
    uint useLog;
    uint autoRange;
    uint colorMap;
    float rangeMin;
    float rangeMax;
    uint groups;
    uint pad;
    // S36a2: the array source's layer, the layers side by side (0: the 2D source), source texels per preview texel and
    // the preview width of one layer
    uint layer;
    uint layers;
    uint step;
    uint layerWidth;
}
pc;

shared vec4 reduceData[256];
shared uint localHistogram[16];

bool sourceValue(ivec2 p, out float v)
{
    if (pc.layers > 0u)
    {
        uint layer = pc.layer;
        if (pc.layers > 1u)
        {
            layer = pc.layer + uint(p.x) / pc.layerWidth;
            p.x   = p.x % int(pc.layerWidth);
        }
        ivec2 q  = p * int(pc.step);
        ivec2 sz = textureSize(sourceArray, 0).xy;
        if (pc.kind == 2u)
        {
            v = 3.0e38;
            for (int y = 0; y < int(pc.step); ++y)
                for (int x = 0; x < int(pc.step); ++x)
                    v = min(v, texelFetch(sourceArray, ivec3(min(q + ivec2(x, y), sz - 1), int(layer)), 0).r);
        }
        else
        {
            vec4 t = texelFetch(sourceArray, ivec3(min(q, sz - 1), int(layer)), 0);
            v      = pc.kind == 4u ? t.g : t.r;
            // The horizon map's "no occluder" (-1e9): no value (drawn black)
            if (v < -1.0e8) return false;
        }
        // Invalid before the log (as the 2D source)
        if (isnan(v) || isinf(v)) return false;
        if (pc.useLog != 0u) v = log2(max(v, 1e-10));
        return !(isnan(v) || isinf(v));
    }
    vec4 t = texelFetch(source, min(p * int(pc.step), textureSize(source, 0) - 1), 0);
    v      = pc.kind == 0u ? luma(t.rgb) * pc.scale : t.r;
    // Invalid before the log (max would turn -inf, and maybe NaN, into the finite floor)
    if (isnan(v) || isinf(v)) return false;
    if (pc.useLog != 0u) v = log2(max(v, 1e-10));
    return !(isnan(v) || isinf(v));
}

// The strip's workgroups per layer (16 columns each; the last of a layer is partly outside it)
uint groupsPerLayer()
{
    return (pc.layerWidth + 15u) / 16u;
}

// The preview texel of this invocation: in a strip, workgroup x covers columns of one layer (a column beyond the layer's
// width is outside the image)
ivec2 texelOf()
{
    if (pc.layers <= 1u) return ivec2(gl_GlobalInvocationID.xy);
    uint perLayer = groupsPerLayer();
    uint column   = (gl_WorkGroupID.x % perLayer) * 16u + gl_LocalInvocationID.x;
    int x         = column < pc.layerWidth ? int((gl_WorkGroupID.x / perLayer) * pc.layerWidth + column) : pc.size.x;
    return ivec2(x, int(gl_GlobalInvocationID.y));
}

vec4 combine(vec4 a, vec4 b)
{
    return vec4(min(a.x, b.x), max(a.y, b.y), a.z + b.z, a.w + b.w);
}

void main()
{
    const vec4 empty = vec4(3.0e38, -3.0e38, 0.0, 0.0);
    uint local       = gl_LocalInvocationIndex;
    if (pc.pass == 0u)
    {
        ivec2 p = texelOf();
        vec4 r  = empty;
        float v;
        if (p.x < pc.size.x && p.y < pc.size.y && sourceValue(p, v)) r = vec4(v, v, v, 1.0);
        reduceData[local] = r;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1)
        {
            if (local < s) reduceData[local] = combine(reduceData[local], reduceData[local + s]);
            barrier();
        }
        if (local == 0u) partials[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = reduceData[0];
    }
    else if (pc.pass == 1u)
    {
        vec4 r = empty;
        for (uint i = local; i < pc.groups; i += 256u) r = combine(r, partials[i]);
        reduceData[local] = r;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1)
        {
            if (local < s) reduceData[local] = combine(reduceData[local], reduceData[local + s]);
            barrier();
        }
        if (local < 16u) histogram[local] = 0u;
        if (local == 0u)
        {
            vec4 t = reduceData[0];
            stats  = t.w > 0.0 ? vec4(t.x, t.y, t.z / t.w, t.w) : vec4(0.0);
            range  = pc.autoRange != 0u ? vec4(stats.x, stats.y, 0.0, 0.0) : vec4(pc.rangeMin, pc.rangeMax, 0.0, 0.0);
        }
        // The strip's per-layer ranges: the partials of the layer's workgroups
        if (pc.layers > 1u && local < pc.layers && local < 4u)
        {
            uint perLayer = groupsPerLayer();
            uint gx       = perLayer * pc.layers;
            vec4 r        = empty;
            for (uint i = 0u; i < pc.groups; ++i)
                if ((i % gx) / perLayer == local) r = combine(r, partials[i]);
            layerRange[local] = r.w > 0.0 ? vec4(r.x, r.y, 0.0, 0.0) : vec4(0.0, 1.0, 0.0, 0.0);
        }
    }
    else
    {
        if (local < 16u) localHistogram[local] = 0u;
        barrier();
        ivec2 p = texelOf();
        if (p.x < pc.size.x && p.y < pc.size.y)
        {
            float v;
            // Non-finite: magenta (horizon: no occluder, black)
            vec3 c = pc.kind >= 3u ? vec3(0.0) : vec3(1.0, 0.0, 1.0);
            if (sourceValue(p, v))
            {
                vec2 r = range.xy;
                if (pc.layers > 1u && pc.autoRange != 0u) r = layerRange[min(uint(p.x) / pc.layerWidth, 3u)].xy;
                float span = r.y - r.x;
                float t    = span > 0.0 ? clamp((v - r.x) / span, 0.0, 1.0) : 0.5;
                c          = pc.colorMap == 1u ? turbo(t) : vec3(t);
                // The histogram over the reported range (a strip layer's colours use its own)
                float g = range.y - range.x;
                float h = g > 0.0 ? clamp((v - range.x) / g, 0.0, 1.0) : 0.5;
                atomicAdd(localHistogram[min(uint(h * 16.0), 15u)], 1u);
            }
            // Row 0 at the top (the images are stored top-down)
            imageStore(preview, p, vec4(c, 1.0));
        }
        barrier();
        if (local < 16u && localHistogram[local] > 0u) atomicAdd(histogram[local], localHistogram[local]);
    }
}
