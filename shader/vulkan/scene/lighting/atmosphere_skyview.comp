#extension GL_GOOGLE_include_directive : require

// The sky-view LUT of the atmosphere (S36, A4; Hillaire 2020, section 5.3): every frame at the camera's height, per
// texel (azimuth, elevation) the in-scattered radiance of the sun and the moon (single scattering with the
// transmittance LUT, multiple scattering with the multiple-scattering LUT; 30 steps), and below the horizon the ground
// (its albedo lit by both bodies through the atmosphere). Stored times kSkyLutScale. The discs, the stars and the
// clouds are not in the LUT.

#include "atmosphere_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outImage;
layout(set = 0, binding = 1) uniform sampler2D transmittanceLut;
layout(set = 0, binding = 2) uniform sampler2D multiScatteringLut;

layout(push_constant) uniform Push
{
    vec4 scales;  // x Rayleigh, y Mie, z ozone, w ground albedo
    vec4 sun;     // xyz towards the sun, w illuminance (lux, top of the atmosphere)
    vec4 moon;
    vec4 camera;  // x: the camera's radius (km), y: the cloudiness
    ivec4 size;
}
pc;

vec3 bodyScattering(vec3 rs, float ms, vec3 dir, vec3 up, float pr, vec4 body)
{
    if (body.w <= 0.0) return vec3(0.0);
    float c     = dot(dir, body.xyz);
    vec3 Ts     = bodyTransmittanceAtRadius(transmittanceLut, pr, vec3(0.0, dot(up, body.xyz), 0.0));
    vec3 psi    = textureLod(multiScatteringLut, multiScatteringUv(pr, dot(up, body.xyz)), 0.0).rgb;
    vec3 single = (rs * rayleighPhase(c) + vec3(ms * miePhase(c))) * Ts;
    return (single + (rs + vec3(ms)) * psi) * body.w;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    vec2 uv     = (vec2(p) + 0.5) / vec2(pc.size.xy);
    float r     = pc.camera.x;
    vec3 dir    = skyViewDir(uv, r);
    float mu    = dir.y;
    bool ground = rayHitsGround(r, mu);
    float d     = ground ? distanceToGround(r, mu) : max(distanceToSphere(r, mu, kTopRadiusKm), 0.0);
    // Non-uniform steps (denser near the camera)
    const int n = 30;
    vec3 L      = vec3(0.0);
    vec3 T      = vec3(1.0);
    float tPrev = 0.0;
    for (int i = 0; i < n; ++i)
    {
        float s  = (float(i) + 1.0) / float(n);
        float t1 = d * s * s;
        float dt = t1 - tPrev;
        float t  = 0.5 * (tPrev + t1);
        tPrev    = t1;
        vec3 pos = vec3(0.0, r, 0.0) + dir * t;
        float pr = length(pos);
        vec3 up  = pos / pr;
        vec3 rs, ext;
        float ms;
        atmosphereMedium(pr - kGroundRadiusKm, pc.scales.xyz, rs, ms, ext);
        vec3 S     = bodyScattering(rs, ms, dir, up, pr, pc.sun) + bodyScattering(rs, ms, dir, up, pr, pc.moon);
        vec3 stepT = exp(-ext * dt);
        L += T * (S - S * stepT) / max(ext, vec3(1e-6));
        T *= stepT;
    }
    if (ground)
    {
        vec3 pos = vec3(0.0, r, 0.0) + dir * d;
        vec3 up  = normalize(pos);
        vec3 E   = vec3(0.0);
        if (pc.sun.w > 0.0)
            E += pc.sun.w * max(dot(up, pc.sun.xyz), 0.0) *
                 transmittanceToTop(transmittanceLut, kGroundRadiusKm + 1e-3, max(dot(up, pc.sun.xyz), 0.0));
        if (pc.moon.w > 0.0)
            E += pc.moon.w * max(dot(up, pc.moon.xyz), 0.0) *
                 transmittanceToTop(transmittanceLut, kGroundRadiusKm + 1e-3, max(dot(up, pc.moon.xyz), 0.0));
        L += T * E * pc.scales.w / kAtmPi;
    }
    // The weather: cloudiness greys the sky (the overcast sky's diffuse look; the cloud layer draws the clouds)
    float grey = 0.7 * pc.camera.y * pc.camera.y;
    L          = mix(L, vec3(dot(L, vec3(0.2126, 0.7152, 0.0722))), grey);
    imageStore(outImage, p, vec4(L * kSkyLutScale, 1.0));
}
