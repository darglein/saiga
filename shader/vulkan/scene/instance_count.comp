#extension GL_GOOGLE_include_directive : require

// The count pass of RenderScene's culling (S18, docs/engine_design.md §10.2): one workgroup per work chunk (chunk y *
// x-count + x of a 2D dispatch), one invocation per instance. Rejects tombstones (scale 0), unset or removed dynamics (mesh 0), zeroed mesh records,
// invalid offset entries (w = 0), instances beyond the mesh's last end distance and instances outside the frustum (5
// planes, no far plane); selects the LOD by the distance of the bounding sphere's centre (the first LOD with distance
// <= endDistance) and counts the instance in its bucket (view, pipeline class, mesh, LOD) with atomicAdd. The bucket and
// the returned slot are stored in the instance's scratch entry (chunk * 256 + invocation), which the write pass uses.

#include "instance_common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 5) buffer Counts
{
    uint counts[];
};
layout(std430, set = 0, binding = 6) writeonly buffer Scratch
{
    uvec2 scratch[];
};

layout(push_constant) uniform Push
{
    // Camera-relative frustum planes (inward normals): dot(n, p) + w >= -radius is inside
    vec4 planes[5];
    float alpha;
    uint meshCount;
    uint bucketsPerView;
    uint view;
    uint chunkCount;
}
pc;

uvec2 cull(WorkChunk ch, uint i)
{
    Pose pose;
    uint mesh, slot;
    if (ch.slot == dynamicChunk)
    {
        DynamicInstance d = dynamics[ch.first + i];
        mesh              = d.mesh;
        if (mesh == 0u) return uvec2(notVisible, 0u);
        slot = d.slot;
        pose = dynamicPose(d, pc.alpha);
    }
    else
    {
        StaticInstance s = instances[ch.first + i];
        if (s.scale == 0.0) return uvec2(notVisible, 0u);
        mesh = s.meshFlags & 0xFFFFu;
        slot = ch.slot;
        pose = staticPose(s);
    }
    if (mesh >= pc.meshCount) return uvec2(notVisible, 0u);
    MeshRecord m = meshes[mesh];
    if (m.lodCount == 0u) return uvec2(notVisible, 0u);
    OffsetEntry o = offsets[slot];
    if (o.hi.w == 0.0) return uvec2(notVisible, 0u);

    vec3 center = placePoint(pose.position, o, rotateQuat(pose.rotation, m.sphere.xyz * pose.scale));
    float d     = length(center);
    if (d > m.lods[m.lodCount - 1u].endDistance) return uvec2(notVisible, 0u);
    float radius = (m.sphere.w + m.padding.x) * pose.scale;
    for (int k = 0; k < 5; ++k)
    {
        if (dot(pc.planes[k].xyz, center) + pc.planes[k].w < -radius) return uvec2(notVisible, 0u);
    }
    uint lod = 0u;
    while (lod + 1u < m.lodCount && d > m.lods[lod].endDistance) lod++;

    uint bucket = pc.view * pc.bucketsPerView + m.bucketBase + lod;
    uint index  = atomicAdd(counts[bucket], 1u);
    return uvec2(bucket | (lod << 30), index);
}

void main()
{
    // A 2D dispatch beyond maxComputeWorkGroupCount[0] (SceneCulling::dispatchChunks): its last row is partial
    uint c = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (c >= pc.chunkCount) return;
    uint i        = gl_LocalInvocationID.x;
    WorkChunk ch  = chunks[c];
    uvec2 entry   = uvec2(notVisible, 0u);
    // Also the invocations beyond the chunk's count: the scratch buffer is reused across frames
    if (i < ch.count) entry = cull(ch, i);
    scratch[c * 256u + i] = entry;
}
