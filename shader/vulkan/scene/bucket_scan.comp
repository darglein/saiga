#extension GL_GOOGLE_include_directive : require

// The scan of RenderScene's culling (S18, docs/engine_design.md §10.2): one workgroup loops over the dense bucket
// array, computes the exclusive prefix sum of the counts and writes instanceCount and firstInstance of each bucket's
// indirect command; the drawn instances per LOD and the non-empty buckets go into the frame's statistics, and the
// counts per LOD of the tracked meshes (their IDs in the statistics, written by the host for this frame; a mesh beyond
// the table, unregistered or without the LOD: 0). S36a2: the buckets of every view (view * bucketsPerView + ...); the
// per-LOD counts, the non-empty buckets and the tracked meshes are the main view's (view 0), and per view the drawn
// instances and triangles.

#include "instance_common.glsl"

layout(local_size_x = 256) in;

// SceneCulling.cpp / RenderSceneTypes.h: maxTrackedMeshes
const uint maxTrackedMeshes = 16u;

layout(std430, set = 0, binding = 5) readonly buffer Counts
{
    uint counts[];
};
// VkDrawIndexedIndirectCommand: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance
layout(std430, set = 0, binding = 7) buffer Commands
{
    uint commands[];
};
layout(std430, set = 0, binding = 8) readonly buffer BucketLods
{
    uint bucketLods[];
};
layout(std430, set = 0, binding = 9) buffer Statistics
{
    uint instancesPerLod[4];
    uint nonEmptyBuckets;
    uint trackedCount;  // host
    uint statisticsPad0;
    uint statisticsPad1;
    uint trackedMeshes[maxTrackedMeshes];  // host
    uint trackedPerLod[maxTrackedMeshes * 4u];
    uint viewInstances[16];
    uint viewTriangles[16];
};

layout(push_constant) uniform Push
{
    uint bucketCount;  // of every view
    uint meshCount;
    uint bucketsPerView;
    uint pad;
}
pc;

shared uint sums[256];
shared uint lodCounts[4];
shared uint nonEmpty;
shared uint viewInst[16];
shared uint viewTri[16];
shared uint running;

void main()
{
    uint lid = gl_LocalInvocationID.x;
    if (lid < 4u) lodCounts[lid] = 0u;
    if (lid < 16u)
    {
        viewInst[lid] = 0u;
        viewTri[lid]  = 0u;
    }
    if (lid == 0u)
    {
        nonEmpty = 0u;
        running  = 0u;
    }
    barrier();
    for (uint first = 0u; first < pc.bucketCount; first += 256u)
    {
        uint b = first + lid;
        uint c = b < pc.bucketCount ? counts[b] : 0u;
        sums[lid] = c;
        barrier();
        // Inclusive scan (Hillis-Steele)
        for (uint off = 1u; off < 256u; off <<= 1)
        {
            uint v = lid >= off ? sums[lid - off] : 0u;
            barrier();
            sums[lid] += v;
            barrier();
        }
        if (b < pc.bucketCount)
        {
            commands[b * 5u + 1u] = c;
            commands[b * 5u + 4u] = running + sums[lid] - c;
            if (c > 0u)
            {
                uint view = b / max(pc.bucketsPerView, 1u);
                if (view == 0u)
                {
                    atomicAdd(lodCounts[bucketLods[b] & 3u], c);
                    atomicAdd(nonEmpty, 1u);
                }
                atomicAdd(viewInst[min(view, 15u)], c);
                atomicAdd(viewTri[min(view, 15u)], c * (commands[b * 5u] / 3u));
            }
        }
        barrier();
        if (lid == 0u) running += sums[255];
        barrier();
    }
    if (lid < 4u) instancesPerLod[lid] = lodCounts[lid];
    if (lid == 0u) nonEmptyBuckets = nonEmpty;
    if (lid < 16u)
    {
        viewInstances[lid] = viewInst[lid];
        viewTriangles[lid] = viewTri[lid];
    }
    // The tracked meshes: invocation 4 t + l reads the count of mesh t's LOD l (the counts are final, view 0)
    if (lid < maxTrackedMeshes * 4u)
    {
        uint t = lid >> 2;
        uint l = lid & 3u;
        uint v = 0u;
        if (t < min(trackedCount, maxTrackedMeshes))
        {
            uint id = trackedMeshes[t];
            if (id < pc.meshCount && l < meshes[id].lodCount) v = counts[meshes[id].bucketBase + l];
        }
        trackedPerLod[lid] = v;
    }
}
