#extension GL_GOOGLE_include_directive : require

// The scan of RenderScene's culling (S18, docs/engine_design.md §10.2): one workgroup loops over the dense bucket
// array, computes the exclusive prefix sum of the counts and writes instanceCount and firstInstance of each bucket's
// indirect command; the drawn instances per LOD and the non-empty buckets go into the frame's statistics.

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 5) readonly buffer Counts
{
    uint counts[];
};
// VkDrawIndexedIndirectCommand: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance
layout(std430, set = 0, binding = 7) buffer Commands
{
    uint commands[];
};
layout(std430, set = 0, binding = 8) readonly buffer BucketLods
{
    uint bucketLods[];
};
layout(std430, set = 0, binding = 9) writeonly buffer Statistics
{
    uint instancesPerLod[4];
    uint nonEmptyBuckets;
};

layout(push_constant) uniform Push
{
    uint bucketCount;
}
pc;

shared uint sums[256];
shared uint lodCounts[4];
shared uint nonEmpty;
shared uint running;

void main()
{
    uint lid = gl_LocalInvocationID.x;
    if (lid < 4u) lodCounts[lid] = 0u;
    if (lid == 0u)
    {
        nonEmpty = 0u;
        running  = 0u;
    }
    barrier();
    for (uint first = 0u; first < pc.bucketCount; first += 256u)
    {
        uint b = first + lid;
        uint c = b < pc.bucketCount ? counts[b] : 0u;
        sums[lid] = c;
        barrier();
        // Inclusive scan (Hillis-Steele)
        for (uint off = 1u; off < 256u; off <<= 1)
        {
            uint v = lid >= off ? sums[lid - off] : 0u;
            barrier();
            sums[lid] += v;
            barrier();
        }
        if (b < pc.bucketCount)
        {
            commands[b * 5u + 1u] = c;
            commands[b * 5u + 4u] = running + sums[lid] - c;
            if (c > 0u)
            {
                atomicAdd(lodCounts[bucketLods[b] & 3u], c);
                atomicAdd(nonEmpty, 1u);
            }
        }
        barrier();
        if (lid == 0u) running += sums[255];
        barrier();
    }
    if (lid < 4u) instancesPerLod[lid] = lodCounts[lid];
    if (lid == 0u) nonEmptyBuckets = nonEmpty;
}
